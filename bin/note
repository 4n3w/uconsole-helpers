#!/usr/bin/env bash
#
# note — a spoken notebook. Capture by voice, retrieve by voice.
#
#   note                  pick and read a note (fzf, with preview)
#   note add "text"       append an entry to today's log
#   note add -            append from stdin — how dictation gets in
#   note inbox            how much is waiting to be triaged
#   note triage           walk the untriaged entries, one at a time
#   note today            print today's entries
#   note search TERM      search everything
#   note read [N]         speak the last N entries aloud (default 1)
#   note edit             open today's log in $EDITOR
#   note sync             pull, then push
#
# Bound to $mod+n in sway/10-uconsole.conf, which dictates straight into it.
#
# WHAT THIS ADDS OVER PLAIN DICTATION
#
# bin/ptt types into whatever window has focus, so it needs a focused text
# field. Capture here has NO TARGET: it works from a blank workspace, from a
# browser, or from a bare TTY with no compositor running at all, because writing
# to a file never needs wtype. Combined with ptt's silence auto-stop that is one
# keypress for a whole thought.
#
# And retrieval can be spoken. On a 5" panel, reading back a week of notes is
# unpleasant; `note read` hands them to bin/say instead. Voice in, voice out —
# the thing this device does that a laptop does not.
#
# daily/ IS AN IMMUTABLE LOG. NOTHING EDITS IT.
#
# Devices append; triage never rewrites. Three things fall out of that, and all
# three were the reason to choose it:
#
#   * `merge=union` is provably safe on those files, because append-only from
#     one writer at a time cannot produce a real conflict. Editing them from a
#     second machine WOULD silently duplicate content under union, with no
#     conflict marker to warn you.
#   * The log stays a faithful record of what was actually said, transcription
#     errors included — which is worth more than it sounds when a garbled entry
#     is ambiguous three weeks later.
#   * "Fix the typo" becomes "promote it into a real note", which is where you
#     wanted the corrected version anyway.
#
# So notes you author live at the vault root; daily/ is only ever the inbox.
#
# ONE FILE PER DAY, APPENDED
#
# Because the hard part of filing a note by voice is NAMING it, and a daily file
# needs no name. Deriving a filename from the first few transcribed words sounds
# clever and produces `2026-08-06-1032-the-thing-about-the.md`.
#
# THE NOTES ARE NOT IN THIS REPO, AND MUST NOT BE
#
# This script is public; its contents are not. Same separation as bin/wifi, which
# starts and stops daemons but never reads a passphrase. $NOTE_DIR defaults to
# ~/notes, which is its own private git repo.
#
# TRANSCRIPTION ERRORS MATTER MORE HERE than in a dictated prompt. In a prompt a
# wrong word is visible immediately; in a note you find it in three weeks with no
# way to reconstruct what you meant. Hence `note edit`, and hence the entries
# carrying a timestamp — so you can at least place what you were doing.

set -uo pipefail

DIR="${NOTE_DIR:-$HOME/notes}"
SAY="${NOTE_SAY:-$(dirname "$(readlink -f "$0")")/say}"
TRIAGE="$(dirname "$(readlink -f "$0")")/note-triage.py"

die() { printf 'note: %s\n' "$*" >&2; exit 1; }

# Daily files are append-only from possibly more than one machine, so a plain
# merge would conflict on any day both touched. `merge=union` is built into git
# and keeps BOTH sides' lines, which for a timestamped log is close to ideal —
# entries may interleave oddly but nothing is lost and nothing needs resolving.
write_gitattributes() {
    local ga="$DIR/.gitattributes"
    grep -qs 'daily/\*.md merge=union' "$ga" 2>/dev/null && return 0
    # SCOPED, not global. An earlier version set `*.md merge=union` across the
    # whole vault, which is actively dangerous for notes you AUTHOR: union keeps
    # both sides' lines, so two machines editing the same real note produce
    # duplicated prose with no conflict to alert you. Union is only correct where
    # writes are strictly appends.
    {
        printf '# Appended-to, never edited: keep both sides rather than conflicting.\n'
        printf 'daily/*.md merge=union\n'
        printf '.triage/done.tsv merge=union\n'
    } >>"$ga"
    # Drop the old global rule if it is still there.
    grep -v '^\*\.md merge=union$' "$ga" >"$ga.tmp" 2>/dev/null && mv "$ga.tmp" "$ga"
}

DAILY="$DIR/daily"
today_file() { printf '%s/%s.md' "$DAILY" "$(date +%F)"; }

ensure_dir() {
    mkdir -p "$DIR" || die "cannot create $DIR"
    # A notes directory is exactly the kind of thing you discover you wanted
    # history for only after losing some, and this box keeps teaching that the
    # SD card is the single point of failure. Init on first use rather than
    # asking.
    [ -d "$DIR/.git" ] && write_gitattributes
    if [ ! -d "$DIR/.git" ]; then
        git -C "$DIR" init -q 2>/dev/null || return 0
        printf '# notes\n\nPrivate. Captured by `note`, mostly by voice.\n' >"$DIR/README.md"
        write_gitattributes
        git -C "$DIR" add -A 2>/dev/null
        git -C "$DIR" commit -qm "Initial commit" 2>/dev/null
        printf '  initialised a git repo in %s\n' "$DIR" >&2
    fi
}

# Commit synchronously, push in the BACKGROUND. Capture must never block on the
# network — wifi is off by default here, and a keybinding that stalls on a DNS
# timeout feels broken — but committing locally protects against nothing that
# matters. The whole reason for git-backing these is SD card failure, and an
# unpushed commit dies with the card exactly as an uncommitted file would.
#
# So the push is detached, time-limited and lock-guarded. If there is no network
# it fails in a few seconds into a log nobody has to read, and the next note or
# `note sync` carries everything forward — pushes are cumulative, so a missed one
# costs nothing.
commit_quietly() {
    [ -d "$DIR/.git" ] || return 0
    git -C "$DIR" add -A >/dev/null 2>&1
    git -C "$DIR" diff --cached --quiet 2>/dev/null && return 0
    git -C "$DIR" commit -qm "note: $(date '+%F %H:%M')" >/dev/null 2>&1
}

PUSHLOG="${XDG_RUNTIME_DIR:-/tmp}/note-push.log"

# NOT inside $DIR: anything there gets swept up by `git add -A` and committed.
autopush() {
    [ "${NOTE_AUTOPUSH:-1}" = "1" ] || return 0
    [ -d "$DIR/.git" ] || return 0
    git -C "$DIR" remote 2>/dev/null | grep -q . || return 0
    # mkdir is the atomic lock here — a burst of notes must not start a pile of
    # concurrent pushes racing each other to the same ref.
    (
        mkdir "$DIR/.git/note-push.lock" 2>/dev/null || exit 0
        trap 'rmdir "$DIR/.git/note-push.lock" 2>/dev/null' EXIT INT TERM
        if timeout 45 git -C "$DIR" push >>"$PUSHLOG" 2>&1; then
            printf '%s pushed\n' "$(date "+%F %T")" >>"$PUSHLOG"
        else
            printf '%s push failed — next note or `note sync` will carry it\n' \
                "$(date "+%F %T")" >>"$PUSHLOG"
        fi
    ) </dev/null >/dev/null 2>&1 &
}

do_add() {
    local text source="typed"
    while [ "${1:-}" = "--source" ]; do
        source="${2:-typed}"; shift 2
    done
    if [ "${1:-}" = "-" ]; then
        text=$(cat)
    elif [ $# -gt 0 ]; then
        text="$*"
    else
        die "add needs text, or - to read stdin"
    fi
    text=$(printf '%s' "$text" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [ -n "${text//[[:space:]]/}" ] || { printf 'note: nothing to add\n' >&2; exit 0; }

    ensure_dir
    mkdir -p "$DAILY"
    local f; f=$(today_file)
    if [ ! -f "$f" ]; then
        # Frontmatter must be the FIRST thing in the file, so it is written at
        # creation and never appended. Costs nothing if you never use a reader
        # that understands it.
        {
            printf -- '---\n'
            printf 'date: %s\n' "$(date +%F)"
            printf 'type: capture-log\n'
            printf -- '---\n\n'
            printf '# %s\n' "$(date '+%A %-d %B %Y')"
        } >"$f"
    fi
    # SECONDS, not just HH:MM. Entry IDs must be unique for per-entry triage
    # state, and testing produced two entries stamped `## 10:08` within a minute
    # of each other — which the triage index could not have told apart.
    printf '\n## %s #%s\n\n%s\n' "$(date +%H:%M:%S)" "$source" "$text" >>"$f"
    commit_quietly
    autopush
    printf '  noted (%s)\n' "$(date +%H:%M)" >&2
}

do_today() {
    local f; f=$(today_file)
    [ -f "$f" ] || { printf 'note: nothing today\n' >&2; exit 0; }
    cat "$f"
}

do_search() {
    [ $# -gt 0 ] || die "search needs a term"
    [ -d "$DIR" ] || die "no notes yet"
    if command -v rg >/dev/null 2>&1; then
        rg --no-heading --color=never -n "$*" "$DIR" 2>/dev/null
    else
        grep -rn "$*" "$DIR" 2>/dev/null
    fi
}

# Speak the last N entries. Entries are separated by "## HH:MM" headings, so the
# timestamp lines are dropped — hearing "hash hash ten thirty two" is not useful.
do_read() {
    local n="${1:-1}"
    [ -d "$DIR" ] || die "no notes yet"
    # Collect the last few day-files into one stream. Read line by line rather
    # than word-splitting `ls`: quoting the whole list makes cat see a single
    # filename containing newlines, which fails silently and returns nothing —
    # which is exactly what it did the first time.
    local text files=""
    while IFS= read -r f; do
        [ -f "$f" ] && files="$files$f\n"
    done < <(ls -1 "$DAILY"/*.md 2>/dev/null | tail -3)
    [ -n "$files" ] || { printf 'note: nothing to read\n' >&2; exit 0; }
    text=$(printf '%b' "$files" | while IFS= read -r f; do [ -n "$f" ] && cat "$f"; done \
        | awk -v n="$n" '
            /^## /   { seg++; next }
            /^# /    { next }
            seg      { buf[seg] = buf[seg] "\n" $0 }
            END      { for (i = seg - n + 1; i <= seg; i++) if (i > 0) printf "%s ", buf[i] }')
    text=$(printf '%s' "$text" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')
    [ -n "${text//[[:space:]]/}" ] || { printf 'note: nothing to read\n' >&2; exit 0; }
    if [ -x "$SAY" ]; then printf '%s' "$text" | "$SAY"; else printf '%s\n' "$text"; fi
}

do_edit() {
    ensure_dir
    local f; f=$(today_file)
    [ -f "$f" ] || printf '# %s\n' "$(date '+%A %-d %B %Y')" >"$f"
    "${EDITOR:-vi}" "$f"
    commit_quietly
}

# Pull then push. Merge rather than rebase, deliberately: the union merge driver
# set up in ensure_dir only applies to merges, and for append-only daily files
# union is very nearly the right answer — it keeps both sides' lines instead of
# raising a conflict over two machines appending to the same day.
do_sync() {
    [ -d "$DIR/.git" ] || die "$DIR is not a git repo"
    commit_quietly
    git -C "$DIR" remote | grep -q . || die "no remote configured; add one with:
  git -C $DIR remote add origin <url>"
    printf '  pulling...\n' >&2
    git -C "$DIR" pull --no-rebase --no-edit 2>&1 | tail -4
    printf '  pushing...\n' >&2
    git -C "$DIR" push 2>&1 | tail -3
}

# Default view: pick an entry, print it. Preview needs the file, so the picker
# lists files and previews their content.
# Lists the whole vault — the daily log AND the notes triage produced. Both
# matter: one is what you said, the other is what you decided it meant.
#
# Globbing only "$DIR"/*.md was right until the log moved into daily/, at which
# point the picker silently stopped showing captures and `note read` found
# nothing at all. Neither errored; they just quietly covered less ground.
do_pick() {
    [ -d "$DIR" ] || die "no notes yet"
    command -v fzf >/dev/null || { do_today; return; }
    local f
    f=$(find "$DIR" -name '*.md' -not -path '*/.*' -newermt '1970-01-01' -printf '%T@ %p\n' 2>/dev/null \
        | sort -rn | cut -d' ' -f2- | grep -v '/README.md$' \
        | fzf --prompt='note> ' --preview 'cat {}' --preview-window=right:60%) || return 0
    [ -n "$f" ] && cat "$f"
}

case "${1:-}" in
    add)    shift; do_add "$@" ;;
    inbox)  ensure_dir; python3 "$TRIAGE" "$DIR" inbox ;;
    triage) shift; ensure_dir; python3 "$TRIAGE" "$DIR" triage "$@" ;;
    dismiss-before) shift; ensure_dir; python3 "$TRIAGE" "$DIR" dismiss-before "${1:-}" \
                    && commit_quietly && autopush ;;
    today)  do_today ;;
    search) shift; do_search "$@" ;;
    read)   shift; do_read "${1:-1}" ;;
    edit)   do_edit ;;
    sync)   do_sync ;;
    '')     do_pick ;;
    -h|--help|help) sed -n '3,15p' "$0" | sed 's/^# \?//' ;;
    *)      die "unknown command '$1' (try --help)" ;;
esac
