#!/usr/bin/env bash
#
# listen — record speech and transcribe it with whisper.cpp.
#
#   listen              record until you press Enter, then print the transcript
#   listen -d 8         record a fixed 8 seconds instead
#   listen -s           record until you stop talking (for bin/converse)
#   listen -f rec.wav   transcribe an existing file, recording nothing
#   listen -m tiny.en   pick a model (default: base.en-q5_1, or $LISTEN_MODEL)
#
# Set $LISTEN_SERVER to a whisper-server on the LAN and transcription happens
# there instead — far faster and more accurate — falling back to the local model
# whenever it cannot be reached.
#   listen -c           also copy the transcript to the clipboard
#   listen -k           keep the recording instead of deleting it
#
# The other half of bin/say. Together they are the voice interface: `say` talks,
# `listen` hears.
#
# -f EXISTS FOR bin/ptt. Push-to-talk does its own recording, because the key
# press and the key release arrive as two separate sway `exec`s and there is no
# stdin to read Enter from. It still wants this script's model resolution, which
# is subtle enough (see DEFAULT_MODEL below) that having two copies of it would
# be a bug waiting to happen. So ptt records, and hands the file to `listen -f`.
#
# WHY THIS NEEDS A USB SOUND CARD
#
# Raspberry Pi boards have NO analog audio input — the bcm2835 audio is
# output-only and the 3.5mm jack cannot take a microphone. Without a USB or
# Bluetooth capture device `arecord -l` lists nothing at all and this script has
# nothing to record from. See CLAUDE.md.
#
# WHISPER IS HAND-BUILT
#
# Not packaged for bullseye, so it is compiled into ~/.local/share/whisper.cpp
# and is UNMANAGED by dpkg — same category as piper and the Nerd Font. A fresh
# image loses it.
#
# 16 kHz mono is not a preference: whisper.cpp requires exactly that, and will
# refuse a file recorded at any other rate.

set -uo pipefail

WHISPER_DIR="${WHISPER_DIR:-$HOME/.local/share/whisper.cpp}"
MODEL_DIR="$WHISPER_DIR/models"

die() { printf '%s\n' "$*" >&2; exit 1; }

# The binary was called `main` for years and is `whisper-cli` in newer releases;
# both may exist in a build tree. Prefer the new name, accept the old.
find_bin() {
    local c
    for c in "$WHISPER_DIR/build/bin/whisper-cli" "$WHISPER_DIR/build/bin/main" \
             "$WHISPER_DIR/whisper-cli" "$WHISPER_DIR/main"; do
        [ -x "$c" ] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

duration=""; model=""; copy=0; keep=0; infile=""; silence=0
while [ $# -gt 0 ]; do
    case "$1" in
        -d|--duration) duration="${2:-}"; shift 2 || die "listen: -d needs seconds" ;;
        -s|--until-silence) silence=1; shift ;;
        -f|--file)     infile="${2:-}";   shift 2 || die "listen: -f needs a path" ;;
        -m|--model)    model="${2:-}";    shift 2 || die "listen: -m needs a model" ;;
        -c|--copy)     copy=1; shift ;;
        -k|--keep)     keep=1; shift ;;
        -h|--help)     sed -n '3,11p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *)             die "listen: unknown option '$1'" ;;
    esac
done

[ -n "$infile" ] && [ -n "$duration" ] && die "listen: -f and -d are mutually exclusive"

### Machine-local config.
#
# LOADED HERE, BEFORE ANYTHING READS A SETTING. It used to be sourced down beside
# the remote-transcription code, which is *after* the model is resolved and after
# the recording is made — so LISTEN_MODEL and LISTEN_AUDIODEV set in this file
# were silently dead, and only LISTEN_SERVER, used further down still, worked.
# Config that loads after its first use is worse than no config at all: it looks
# set and does nothing. Exactly the trap that killed LISTEN_MODEL in ~/.profile.
#
# An explicit environment variable still wins, so one-off overrides work — the
# file uses plain assignments, so sourcing it would otherwise clobber them.
_env_server="${LISTEN_SERVER:-}"
_env_model="${LISTEN_MODEL:-}"
_env_dev="${LISTEN_AUDIODEV:-}"
VOICE_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/uconsole/voice.conf"
[ -r "$VOICE_CONF" ] && . "$VOICE_CONF"
[ -n "$_env_server" ] && LISTEN_SERVER="$_env_server"
[ -n "$_env_model" ]  && LISTEN_MODEL="$_env_model"
[ -n "$_env_dev" ]    && LISTEN_AUDIODEV="$_env_dev"
LISTEN_SERVER="${LISTEN_SERVER:-}"
LISTEN_SERVER_TIMEOUT="${LISTEN_SERVER_TIMEOUT:-10}"

# NOT fatal if absent. The local model is the FALLBACK, and on a machine that
# only ever talks to the server — the Mac beside it, say — there is no reason to
# require a hand-built whisper before recording a single sample. Failing here
# also fails too early to know whether $LISTEN_SERVER is set, since voice.conf is
# read further down. So resolve what exists and complain at the point of use.
BIN=$(find_bin) || BIN=""

# Resolve the model: explicit -m, else $LISTEN_MODEL, else the default below,
# else whatever is actually installed.
#
# This used to pick the SMALLEST file, which was a trap: adding a quantized model
# silently changed the default, because ggml-base.en-q5_1 (57 MB) is smaller than
# ggml-tiny.en (75 MB) while being a bigger, slower, more accurate model. Name the
# default explicitly instead.
#
# base.en-q5_1 is the default because ACCURACY WON — a reversal, decided
# 2026-08-05, and the reasoning it replaces is worth keeping.
#
# The old default was tiny.en, chosen purely on latency: on 4.6 s of audio it
# takes 13.5 s against base.en-q5_1's 24.6 s. That was the right call when the
# only measurement available was a benchmark phrase both models got word-perfect,
# so the extra ~11 s bought nothing visible.
#
# Two things changed. The mic became a RØDE VideoMic GO II, so SNR stopped being
# the limiting factor; and bin/ptt made this a DICTATION tool rather than a
# transcription toy. Real prose exposed what a benchmark phrase hid — tiny.en
# turned "a giant blob of plasma" into "a giant blob of plaid mode". It handles
# common words and drops exactly the technical ones you are least willing to
# retype. Against a ~14 s wait you were already tolerating, ~25 s is cheap.
#
# Quantized beats fp16 on this CPU: whisper is memory-bandwidth bound here, so
# base.en-q5_1 is both FASTER and SMALLER than fp16 base.en (24.6 s / 57 MB
# against 34.3 s / 142 MB) for identical output. Never reach for fp16 base.en.
# small.en-q5_1 is word-perfect and unusable at 72.4 s, 15.7x real time.
#
# Reach back for tiny.en with -m when latency matters more than words.
DEFAULT_MODEL="${LISTEN_MODEL:-base.en-q5_1}"

resolve_model() {
    case "$1" in
        /*) printf '%s' "$1"; return ;;
        *)  printf '%s/ggml-%s.bin' "$MODEL_DIR" "$1" ;;
    esac
}

if [ -n "$model" ]; then
    MODEL=$(resolve_model "$model")
    [ -f "$MODEL" ] || die "listen: no such model: $model (looked for $MODEL)"
else
    MODEL=$(resolve_model "$DEFAULT_MODEL")
    if [ ! -f "$MODEL" ]; then
        # Default is not installed — fall back to any model rather than failing.
        MODEL=$(ls -S "$MODEL_DIR"/ggml-*.bin 2>/dev/null | tail -1)
    fi
fi
[ -n "${MODEL:-}" ] && [ -f "$MODEL" ] || MODEL=""   # see the BIN note above

### Encoder audio context — the single biggest speed lever on this board.
#
# Whisper's encoder processes a fixed 30-second window no matter how short the
# clip is, and on this CPU that fixed cost is ~90% of a short transcription.
# `-ac N` shrinks that window. Measured on base.en-q5_1 with a 5 s clip, best of
# three interleaved runs: 12.9 s default, 5.2 s with -ac 512. Same transcript.
#
# 1500 frames cover 30 s, so audio needs duration x 50 frames. This asks for
# DOUBLE that, because undersizing is punished savagely — a 30 s clip forced
# through -ac 512 took 101.9 s against 26.1 s at full context, FOUR TIMES SLOWER,
# and returned "the lazy easy- decay rocks" where the default got the sentence
# right. Whisper's temperature fallback retries low-confidence output, so too
# small a context loses on both speed and accuracy at once. It is strictly worse
# than not using the flag.
#
# Above ~15 s of audio the doubled requirement reaches 1500 and this prints
# nothing, so long recordings silently fall back to stock behaviour and can never
# hit that cliff.
#
# $LISTEN_AUDIO_CTX overrides: 0 disables the flag entirely, N forces a value.
audio_ctx_for() {
    [ "${LISTEN_AUDIO_CTX:-auto}" = "0" ] && return 0
    if [ "${LISTEN_AUDIO_CTX:-auto}" != "auto" ]; then
        printf '%s' "$LISTEN_AUDIO_CTX"; return 0
    fi
    python3 - "$1" <<'PY' 2>/dev/null
import sys, wave
try:
    w = wave.open(sys.argv[1])
    secs = w.getnframes() / float(w.getframerate())
except Exception:
    sys.exit(0)                      # unreadable: say nothing, use the default
ctx = int(secs * 50.0 * 2.0) + 1     # 50 frames/s, doubled for headroom
if ctx >= 1500:
    sys.exit(0)                      # full context is the default; pass no flag
print(max(256, ctx))
PY
}

### Is the capture device actually producing anything?
#
# A dead input does not announce itself: it records a file of exactly the right
# size at exactly the right rate, whisper returns "." or a hallucinated fragment,
# and nothing anywhere says "your microphone is off". That is a genuinely
# confusing failure — it presents as "the transcription is bad" rather than as a
# hardware fault. bin/ptt has gated on this for a while; listen did not, so
# running it on a new machine with the wrong input selected just looked broken.
#
# -70 dBFS is the same threshold ptt uses, and it sits in a ~40 dB gulf: a quiet
# room with a working mic reads about -43, a dead one about -87 to -96. It is a
# DEAD-MIC ALARM, not a speech detector — separating "quiet room" from "someone
# talking" is a far narrower margin and a threshold slightly wrong there would
# eat real dictation.
#
# Warns rather than dies, and stays silent if python3 is missing or the file is
# not what it expects. A diagnostic that can block transcription is a bad trade.
warn_if_silent() {
    command -v python3 >/dev/null 2>&1 || return 0
    verdict=$(python3 - "$1" <<'RMS' 2>/dev/null
import array, math, sys
try:
    d = open(sys.argv[1], "rb").read()
    i = d.find(b"data", 12)
    off = i + 8 if i != -1 else 44
    a = array.array("h")
    a.frombytes(d[off:off + (len(d) - off) // 2 * 2])
    a = a[::16] or a                       # flat cost regardless of length
    if len(a):
        acc = sum(v * v for v in a)
        db = -99.0 if acc == 0 else 20 * math.log10(math.sqrt(acc / len(a)) / 32768.0)
        print("%s %.1f" % ("SILENT" if db < -70 else "OK", db))
except Exception:
    pass
RMS
)
    case "$verdict" in
        SILENT*)
            printf '  WARNING: capture was %s dBFS — the mic is producing nothing.\n' \
                   "${verdict#SILENT }" >&2
            printf '           Check it is unmuted and selected ($LISTEN_AUDIODEV).\n' >&2 ;;
    esac
}

### Recording backend.
#
# arecord on this board; sox's `rec` anywhere else, which is what lets converse
# run on the Mac beside the model. Both are asked for exactly what whisper wants
# — 16 kHz mono signed 16-bit — so nothing downstream has to know which ran.
#
# sox is NOT a drop-in: duration is a `trim 0 N` effect appended after the file
# rather than a -d flag, and the sample format is three separate options. It does
# write a plain 44-byte WAV header, which matters because ptt-silence-watch.py
# reads a growing file and has to find where the samples start.
RECORDER=""
if command -v arecord >/dev/null 2>&1; then
    RECORDER=arecord
elif command -v rec >/dev/null 2>&1; then
    RECORDER=rec
fi

record_wav() {   # $1 wav, $2 max seconds ("" = until killed)
    case "$RECORDER" in
        arecord)
            if [ -n "$2" ]; then
                arecord -q -f S16_LE -r 16000 -c 1 -d "$2" "$1" 2>/dev/null
            else
                arecord -q -f S16_LE -r 16000 -c 1 "$1" 2>/dev/null
            fi ;;
        rec)
            # $LISTEN_AUDIODEV picks the input. Worth setting: a Mac's default
            # input is often an audio interface with nothing plugged into
            # channel 1, which records a convincing -96 dBFS of nothing. List
            # the names with:  sox -V6 -t coreaudio "" -n trim 0 0.1
            _src=""
            if [ -n "${LISTEN_AUDIODEV:-}" ]; then
                case "$(uname -s)" in
                    Darwin) _drv=coreaudio ;;
                    *)      _drv=alsa ;;
                esac
                sox -q -t "$_drv" "$LISTEN_AUDIODEV" -c 1 -r 16000 -b 16 \
                    -e signed-integer "$1" ${2:+trim 0 "$2"} 2>/dev/null
            else
                rec -q -c 1 -r 16000 -b 16 -e signed-integer "$1" \
                    ${2:+trim 0 "$2"} 2>/dev/null
            fi ;;
    esac
}

if [ -n "$infile" ]; then
    # Someone else's file. Never delete it, whatever -k says.
    [ -f "$infile" ] || die "listen: no such file: $infile"
    [ -s "$infile" ] || die "listen: empty recording: $infile"
    wav="$infile"
else
    [ -n "$RECORDER" ] || die "listen: no recorder found (install alsa-utils, or sox for rec)"
    if [ "$RECORDER" = arecord ]; then
        arecord -l 2>/dev/null | grep -q '^card' \
            || die "listen: no capture device. This board has no built-in mic — plug in a USB one."
    fi

    # A directory, not a file, because the name has to end in .wav for sox to
    # infer the format AND the XXXXXX has to be last for BSD mktemp. Those two
    # cannot both hold in one template. GNU mktemp accepts XXXXXX anywhere,
    # which is why `listen-XXXXXX.wav` worked here for months while producing a
    # file literally called that on a Mac — so every concurrent run collided.
    tmpd=$(mktemp -d "${TMPDIR:-/tmp}/listen.XXXXXX") || die "listen: mktemp failed"
    wav="$tmpd/rec.wav"
    cleanup() { [ "$keep" = 1 ] || rm -rf "$tmpd"; }
    trap cleanup EXIT INT TERM

    # 16 kHz mono, signed 16-bit — exactly what whisper.cpp wants.
    if [ "$silence" = 1 ]; then
        # Same detection bin/ptt uses, via the same helper — a second
        # implementation of "have they stopped talking" would drift from it.
        printf '  listening — speak, then stop\n' >&2
        record_wav "$wav" 120 &
        rec_pid=$!
        python3 "$(dirname "$(readlink -f "$0")")/ptt-silence-watch.py" --wait "$wav" \
            "${LISTEN_SILENCE_SECS:-2}" "${PTT_SILENCE_END_DBFS:-auto}" \
            "${PTT_SILENCE_MARGIN_DB:-12}" 2>/dev/null
        kill "$rec_pid" 2>/dev/null; wait "$rec_pid" 2>/dev/null
    elif [ -n "$duration" ]; then
        printf '  recording %ss — speak now\n' "$duration" >&2
        record_wav "$wav" "$duration"
    else
        printf '  recording — press Enter to stop\n' >&2
        record_wav "$wav" "" &
        rec_pid=$!
        read -r _ </dev/tty 2>/dev/null || true
        kill "$rec_pid" 2>/dev/null
        wait "$rec_pid" 2>/dev/null
    fi

    [ -s "$wav" ] || die "listen: nothing was recorded"
    warn_if_silent "$wav"
fi

### Remote transcription, with the local model as fallback.
#
# $LISTEN_SERVER points at a whisper-server on the LAN. Measured against a Mac
# Studio M2 Ultra running large-v3-turbo on Metal, including the wifi round trip:
#
#     audio    remote     local (base.en-q5_1)
#     3 s      0.28 s     3.45 s
#     5 s      0.36 s     5.09 s
#     12 s     0.52 s     14.56 s
#
# 0.04-0.07x real time, so 12-28x faster — AND more accurate, because a machine
# with 192 GB can afford large-v3-turbo. It transcribes "coronal mass ejection"
# and "heliosphere" where base.en-q5_1 gives "coral mass ejection", which is
# precisely the class of error that made this box abandon tiny.en.
#
# THE FALLBACK IS THE POINT, not a nicety. Wifi is off by default here and the
# whole setup has been offline-capable from the start; a remote dependency that
# turned dictation into an error when the LAN is absent would be a bad trade for
# any amount of speed. If the server does not answer within the timeout, the
# local model runs and the only cost is the wait.
#
# Empty LISTEN_SERVER disables this entirely.
# Machine-local settings, chiefly the LAN server's address. A config file rather
# than ~/.profile for three reasons: a private address has no business in a public
# repo; login-path exports are subject to the export-above-the-sway-hook ordering
# trap that already silently killed LISTEN_MODEL once; and config that matters to
# exactly one command belongs beside that command, where it also takes effect
# immediately instead of at next login.
#
# An explicit environment variable still wins, so one-off overrides work.
# Loaded at the top of the script — see "Machine-local config" there.

transcribe_remote() {   # wav -> text on stdout; non-zero if unusable
    [ -n "$LISTEN_SERVER" ] || return 1
    command -v curl >/dev/null 2>&1 || return 1
    curl -sf --max-time "$LISTEN_SERVER_TIMEOUT" \
        -F "file=@$1" -F "response_format=text" \
        "${LISTEN_SERVER%/}/inference" 2>/dev/null \
        | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' \
        | grep -v '^$' | paste -sd' ' -
}

text=""
if [ -n "$LISTEN_SERVER" ]; then
    printf '  transcribing (remote: %s)...\n' "$LISTEN_SERVER" >&2
    text=$(transcribe_remote "$wav")
    [ -z "${text//[[:space:]]/}" ] && {
        printf '  remote unavailable — falling back to the local model\n' >&2
        text=""
    }
fi

if [ -z "$text" ]; then
if [ -z "$BIN" ] || [ -z "$MODEL" ]; then
    if [ -n "$LISTEN_SERVER" ]; then
        die "listen: $LISTEN_SERVER did not answer, and there is no local model to fall back to"
    fi
    die "listen: no whisper.cpp under $WHISPER_DIR, and no LISTEN_SERVER set"
fi
AC=$(audio_ctx_for "$wav")
AC_ARGS=""
[ -n "${AC:-}" ] && AC_ARGS="-ac $AC"

printf '  transcribing (%s%s)...\n' "$(basename "$MODEL")" \
       "$([ -n "${AC:-}" ] && printf ', ac=%s' "$AC")" >&2
# -nt drops timestamps, -np drops the progress banner, so stdout is just text.
# Beam search is deliberately left at its default of 5. `-bs 1` is a further 1.4x
# on top of -ac, but beam search is a real accuracy safeguard and this box has
# already chosen accuracy over speed once, when tiny.en turned "plasma" into
# "plaid mode". One clean test sentence is not enough evidence to give it up.
text=$("$BIN" -m "$MODEL" -f "$wav" -l en -nt -np $AC_ARGS 2>/dev/null | tr -d '\r' \
        | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | paste -sd' ' -)
fi

[ -n "${text:-}" ] || die "listen: no speech recognised"
printf '%s\n' "$text"

if [ "$copy" = 1 ]; then
    if command -v wl-copy >/dev/null 2>&1; then
        printf '%s' "$text" | wl-copy
        printf '  (copied to clipboard)\n' >&2
    else
        printf '  (wl-copy not installed — install wl-clipboard to use -c)\n' >&2
    fi
fi
[ "$keep" = 1 ] && [ -z "$infile" ] && printf '  recording kept at %s\n' "$wav" >&2
exit 0
